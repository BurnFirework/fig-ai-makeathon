# Bring your own subscription: install Claude Code or use the bundled Codex CLI.
# Authenticate using `claude auth login` or `pnpm --filter unfold exec codex login` on this computer.
UNFOLD_PROVIDER=auto
# Optional executable overrides (paths, not shell commands).
# UNFOLD_CLAUDE_BIN=/absolute/path/to/claude
# UNFOLD_CODEX_BIN=/absolute/path/to/codex
# Optional model; otherwise use the CLI default.
# UNFOLD_MODEL=
# Optional build-time override of the bundled trial key (expires 2027-02-17).
VITE_TLDRAW_LICENSE_KEY=
PORT=3001
# Explore board runs in the local runtime with a signed-in AI CLI.
# Public web search/page reading need no application key.
# Optional dynamic read-only research tools: Composio API key permissions must
# include Session management Read/Write and Session tool execution Write.
# COMPOSIO_API_KEY=
# Optional: Parallel web search key. Without it the free tier applies and rate-limits busy sessions.
# PARALLEL_API_KEY=
# Optional Explore speed settings (defaults shown). Research steps use the quick model: Sonnet for Claude Code, Luna for Codex.
# UNFOLD_EXPLORE_STEPS=6
# UNFOLD_EXPLORE_SECONDS=150
# UNFOLD_EXPLORE_FINAL=fast  (light or default write the final result with the selected model)
# UNFOLD_FAST_MODEL=  (overrides the quick model)
# Optional connection owner; defaults to unfold-explore.
# COMPOSIO_USER_ID=unfold-explore
# Optional independent-card concurrency (default 3, clamped to 1–8).
# UNFOLD_EXPLORE_CONCURRENCY=3
# Legacy concert search compatibility only; not required for dynamic discovery.
# TICKETMASTER_API_KEY=
